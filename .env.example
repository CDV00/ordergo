# Copy thành .env trước khi `docker compose up`
#   cp .env.example .env

# ─── Mode ────────────────────────────────────────────────
NODE_ENV=production

# ─── Ports expose ra host ────────────────────────────────
WEB_PORT=3000
API_PORT=4000
MONGO_PORT=27017
REDIS_PORT=6379

# ─── Mongo DB name ───────────────────────────────────────
MONGODB_DB=ordergo

# ─── JWT secrets — sinh random ≥ 32 ký tự ────────────────
# Linux/Mac:  openssl rand -base64 48
# Windows:    [Convert]::ToBase64String((1..48 | %{Get-Random -Min 0 -Max 256}))
JWT_ACCESS_SECRET=change_me_to_random_32_plus_chars_for_access_token
JWT_REFRESH_SECRET=change_me_to_random_32_plus_chars_for_refresh_token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── CORS — danh sách origin phân cách bởi dấu phẩy ──────
CORS_ORIGINS=http://localhost:3000

# ─── URL public mà browser sẽ gọi tới API ────────────────
# Bake vào FE build (NEXT_PUBLIC_*). Production đổi thành domain thật.
PUBLIC_API_URL=http://localhost:4000/v1
