# ─────────────────────────────────────────────────────────
# OrderGo staging/demo — env cho docker-compose.prod.yml
#   cp deploy/.env.staging.example .env && chmod 600 .env
# File .env nằm ở GỐC workspace (cạnh docker-compose.prod.yml), không commit.
# Không có secret thật trong file này — mọi giá trị change_me phải thay.
# ─────────────────────────────────────────────────────────

# ─── Domain (2 DNS A record trỏ về IP VPS) ───────────────
WEB_DOMAIN=demo.example.com
API_DOMAIN=api.demo.example.com

# URL browser gọi API — bake vào bundle web lúc build (đổi → phải build lại web).
PUBLIC_API_URL=https://api.demo.example.com/v1

# Origin của web được phép gọi API + Socket.IO (phân cách bởi dấu phẩy, không có "/" cuối).
CORS_ORIGINS=https://demo.example.com

# ─── JWT secrets — ≥ 32 ký tự, mỗi biến một giá trị khác nhau ─
# Sinh trên Linux:  openssl rand -hex 48
JWT_ACCESS_SECRET=change_me_run_openssl_rand_hex_48_access_secret_xxxxxxxx
JWT_REFRESH_SECRET=change_me_run_openssl_rand_hex_48_refresh_secret_xxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── MongoDB ─────────────────────────────────────────────
MONGODB_DB=ordergo
# Mặc định (không auth, Mongo chỉ nằm trong network nội bộ Docker):
#   mongodb://mongo:27017/?replicaSet=rs0&directConnection=true
# Bật auth (thêm -f deploy/docker-compose.mongo-auth.yml) → bỏ comment và điền:
# MONGODB_URI=mongodb://ordergo_root:<MONGO_ROOT_PASSWORD>@mongo:27017/?replicaSet=rs0&directConnection=true&authSource=admin
# Mật khẩu: openssl rand -hex 24  (hex → không cần URL-encode trong MONGODB_URI)
# Replica key: openssl rand -base64 756 | tr -d '\n'
# MONGO_ROOT_USER=ordergo_root
# MONGO_ROOT_PASSWORD=
# MONGO_REPLICA_KEY=
# WiredTiger cache (GB). VPS 2GB: 0.5 · VPS 4GB: 1
MONGO_CACHE_GB=0.5

# ─── Upload ảnh ──────────────────────────────────────────
# Cố định /app/uploads trong container (volume uploads-data) — compose ghi đè, ghi ra đây để biết.
UPLOAD_DIR=/app/uploads

# API đứng sau Caddy → tin 1 proxy (bắt buộc để giới hạn đăng nhập theo IP đúng từng khách)
TRUST_PROXY=1
# Bật Swagger ở staging nếu cần (production mặc định tắt)
# SWAGGER_ENABLED=1

# ─── Backup ──────────────────────────────────────────────
BACKUP_KEEP=14
# Giờ chạy backup hằng ngày theo UTC (20 = 03:00 giờ Việt Nam)
BACKUP_HOUR_UTC=20

# ─── Observability (tuỳ chọn) ────────────────────────────
# API đọc SENTRY_DSN; để trống/không khai báo = tắt Sentry.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# ─── Realtime (tuỳ chọn) ─────────────────────────────────
# Tắt Socket.IO (client tự fallback polling):
# REALTIME_DISABLED=1

# ─── Dữ liệu demo (chỉ dùng cho deploy/seed-demo.sh) ─────
# Seed tạo tài khoản 0900000001…0900000005 — mật khẩu mặc định "ordergo123" là CÔNG KHAI.
# Nên đặt DEMO_PASSWORD riêng trước khi seed trên server có domain public.
# Bỏ comment khi dùng — KHÔNG để dòng "KEY=" rỗng (mật khẩu rỗng!).
# DEMO_PASSWORD=change_me_demo_password
# VietQR: chỉ điền tài khoản ngân hàng THẬT của quán demo, không bịa số tài khoản.
# DEMO_BANK_BIN=970436
# DEMO_BANK_NAME=Vietcombank
# DEMO_BANK_ACCOUNT=
# DEMO_BANK_ACCOUNT_NAME=
